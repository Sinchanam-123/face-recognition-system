# Superseded / corrupt data.
# NOTE: git only treats '#' as a comment at the START of a line. An inline
# comment becomes part of the pattern, so these rules must stay comment-free.
# known_faces/ holds 3023 all-black images from the original dataset.
known_faces/
# encodings.pkl holds the old 128-d dlib encodings (InsightFace uses face_db.pkl).
encodings.pkl

# Runtime-generated files.
# face_db.pkl is your registered faces (local data).
face_db.pkl
# attendance_*.csv is exported attendance, and may contain real names (PII).
attendance_*.csv

.claude/
